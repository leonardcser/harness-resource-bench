{
  "name": "harness-resource-bench-web",
  "private": true,
  "type": "module",
  "scripts": {
    "data": "bun scripts/data.ts",
    "og": "bun scripts/og.ts",
    "dev": "bun run data && bun run og && vite",
    "build": "bun run data && bun run og && vite build",
    "preview": "vite preview",
    "check": "rm -rf .svelte-check && svelte-check --tsgo",
    "format": "prettier --write .",
    "lint": "prettier --check . && bun run check"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "d3-array": "^3.2.5",
    "d3-scale": "^4.0.3",
    "d3-shape": "^3.2.1",
    "mode-watcher": "^1.1.0",
    "svelte-icons-pack": "^3.1.3"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.5",
    "@tsconfig/svelte": "^5.0.8",
    "@types/bun": "^1.4.4",
    "@types/d3-array": "^3.2.2",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-shape": "^3.2.0",
    "@typescript/native": "npm:typescript@7",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "satori": "^0.63.2",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "tailwindcss": "^4.3.5",
    "typescript": "~6",
    "vite": "^8.3.6"
  }
}
